# Squarewave Digital: the static Nuxt output served by Apache on cPanel.
# This file is copied into the build output from public/.

Options -Indexes
DirectorySlash Off

RewriteEngine On

# Always https, on whichever host this is deployed to (staging included).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# No www.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Old WordPress addresses.
RewriteRule ^coming-soon/?$ / [R=301,L]
RewriteRule ^(sitemaps\.xml|sitemap_index\.xml|wp-sitemap\.xml)$ /sitemap.xml [R=301,L]
RewriteRule ^(wp-login\.php|wp-admin(/.*)?)$ https://client.squarewavedigital.co.uk/wp-login.php [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]

# Canonical URLs have no trailing slash: /about, not /about/.
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Nuxt writes each route as a folder with index.html. Serve /about from
# /about/index.html directly, with no redirect hop.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)$ $1/index.html [L]

ErrorDocument 404 /404.html

# Compression.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching. Nuxt's /_nuxt/ files carry a content hash in the name, so
# scripts, styles and fonts can be cached for a year; pages must not be.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep the deployment tool's state file private.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
